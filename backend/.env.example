# ── Required ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/metmomo
# Long random string, e.g. `openssl rand -hex 32`
SECRET_KEY=change-me

# ── URLs ─────────────────────────────────────────────────
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Comma-separated list if the frontend is served from several origins
# CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind a reverse proxy (nginx, Render, Railway…)
# TRUST_PROXY=1
JWT_EXPIRES_IN=7d

# ── First admin (created on start if no admin exists) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email (password-reset OTPs) ──────────────────────────
EMAIL_USER=
EMAIL_PASSWORD=

# ── AI features (delivery estimate, assistant, summaries) ─
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ── Payments ─────────────────────────────────────────────
KHALTI_SECRET_KEY=
# Sandbox: https://dev.khalti.com/api/v2
KHALTI_BASE_URL=https://a.khalti.com/api/v2
# eSewa defaults to the public sandbox; set all four for production
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=
ESEWA_STATUS_URL=

# ── Image storage (optional; local disk when unset) ──────
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud-name>
